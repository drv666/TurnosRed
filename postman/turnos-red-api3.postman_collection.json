    {
      "name": "04 Crear especialidad",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api3BaseUrl}}/especialidades",
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\":\"Prueba API3 {{api3Run}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"api3Run\", Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Especialidad creada\", () => { const e=pm.response.json(); pm.expect(e.id).to.be.a(\"number\").above(0); pm.expect(e.nombre).to.eql(\"Prueba API3 \"+pm.collectionVariables.get(\"api3Run\")); pm.collectionVariables.set(\"api3EspecialidadId\",e.id); });"
            ]
          }
        }
      ]
    },
