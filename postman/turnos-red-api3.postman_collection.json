{
  "info": {
    "name": "TurnosRed API 3 - Verificación",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar completa en orden, una iteración. Crea datos ficticios propios y los elimina al terminar. Puerto 3003. Las respuestas 400 y 404 son esperadas en los casos negativos."
  },
  "variable": [
    {
      "key": "api3BaseUrl",
      "value": "http://localhost:3003"
    },
    {
      "key": "api3Run",
      "value": ""
    },
    {
      "key": "api3EspecialidadId",
      "value": ""
    },
    {
      "key": "api3ProfesionalId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Bienvenida",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api3BaseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Datos esperados\", () => pm.expect(pm.response.json().message).to.eql(\"Hello World - Bienvenido a TurnosRed API 3\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Ruta inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api3BaseUrl}}/ruta-inexistente-api3"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Error JSON coherente\", () => { const e=pm.response.json(); pm.expect(e.status).to.eql(404); pm.expect(e.message).to.be.a(\"string\").and.not.empty; pm.expect(e.code).to.be.a(\"string\"); pm.expect(e.details).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Listar especialidades",
